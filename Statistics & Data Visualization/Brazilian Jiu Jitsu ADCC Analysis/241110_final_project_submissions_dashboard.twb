    <worksheet name='Win Ratio By Country for Fighters With More Than 2 Wins'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='20'>Win Ratio by Country</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Fighters with 2 Wins or More (Mean = </run>
            <run fontcolor='#000000' fontsize='8'>1.7)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
