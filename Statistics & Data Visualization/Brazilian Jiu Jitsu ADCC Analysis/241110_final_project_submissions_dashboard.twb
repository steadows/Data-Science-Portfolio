            <column caption='Leg Submissions' datatype='integer' name='[Calculation_3192981780189806593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [submission] IN (&#10;&quot;Heel hook&quot;, &#10;&quot;Kneebar&quot;, &#10;&quot;Dogbar&quot;,&#10;&quot;Straight ankle lock&quot;, &#10;&quot;Toe hold&quot;,&#10;&quot;Calf slicer&quot;,&#10;&quot;Estima lock&quot;,&#10;&quot;Footlock&quot;,&#10;&quot;Inside heel hook&quot;,&#10;&quot;Leg lock&quot;,&#10;&quot;Outside heel hook&quot;&#10;) THEN 1 ELSE 0 END' />
            </column>
            <column caption='Chokes' datatype='integer' name='[Calculation_3192981780280860676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [submission] IN (&#10;    &quot;Anaconda&quot;,&#10;&quot;Choke&quot;,&#10;&quot;D&apos;arce choke&quot;,&#10;&quot;Ezekiel&quot;,&#10;&quot;Guillotine&quot;,&#10;&quot;Headlock&quot;,&#10;&quot;Katagatame&quot;,&#10;&quot;North south choke&quot;,&#10;&quot;RNC&quot;,&#10;&quot;Short choke&quot;,&#10;&quot;Triangle&quot;,&#10;) THEN 1 ELSE 0 END' />
            </column>
            <column caption='Arm Locks' datatype='integer' name='[Calculation_3192981780286836742]' role='measure' type='quantitative'>
