      <aliases enabled='yes' />
      <column caption='Adjusted Win Ratio' datatype='real' name='[Calculation_1634454837107077120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[win_ratio] * LOG([total_wins] + 1)' />
      </column>
      <column caption='Filtered Win Ratio' datatype='real' name='[Calculation_1634454837115772929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_wins] &gt;= 5 THEN [win_ratio] END' />
      </column>
      <column aggregation='Avg' caption='Rounded Latitude' datatype='real' name='[Calculation_1634454837120626690]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='ROUND([latitude], 0)' />
      </column>
      <column aggregation='Avg' caption='Rounded Longitude' datatype='real' name='[Calculation_1634454837120811011]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative'>
        <calculation class='tableau' formula='ROUND([longitude], 0&#10;)' />
      </column>
      <column caption='Sub Win Ratio per 2 Fights' datatype='real' name='[Calculation_1634454837350400004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sub_win_ratio] * 2 / [total_fights]' />
      </column>
      <column caption='AVG(Sub Win Ratio)' datatype='real' name='[Calculation_1634454837352476678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([sub_win_ratio])' />
      </column>
      <column caption='STDEV(Sub Win Ratio)' datatype='real' name='[Calculation_1634454837352620039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([sub_win_ratio])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1634454837352771592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sub_win_ratio] - [Calculation_1634454837352476678]) / [Calculation_1634454837352620039]' />
      </column>
